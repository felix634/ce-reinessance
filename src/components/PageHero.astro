---
interface Props { eyebrow: string; title: string; intro: string; index?: string; }
const { eyebrow, title, intro, index = '01' } = Astro.props;
---
<section class="page-hero shell">
  <div class="page-hero-index" aria-hidden="true">{index}</div>
  <div><p class="eyebrow">{eyebrow}</p><h1>{title}</h1></div>
  <p class="page-intro">{intro}</p>
</section>
