---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const projects = [
  { title: 'The Ambassador’s Residence', location: 'Budapest, Hungary', image: '/assets/images/budapest.png', type: 'Heritage restoration', description: 'A complete façade and interior restoration that reconnects formal 19th-century rooms with contemporary family life.' },
  { title: 'The Old Town Penthouse', location: 'Prague, Czechia', image: '/assets/images/prague.png', type: 'Penthouse conversion', description: 'An unused historic roof volume transformed into a quiet, light-filled residence above Prague’s Old Town.' },
  { title: 'The Quiet Townhouse', location: 'Vienna, Austria', image: '/assets/images/vienna.png', type: 'Luxury modernisation', description: 'Biedermeier proportions, floors and plasterwork preserved around a restrained new material language.' },
  { title: 'The Garden Estate', location: 'Warsaw, Poland', image: '/assets/images/warsaw.png', type: 'Full property renewal', description: 'A generous family estate renewed from structure to landscape, with greatly improved comfort and performance.' },
];
---

<Layout title="Selected Restoration Projects" description="Explore selected CE Reinessance restoration and modernisation projects in Budapest, Vienna, Prague and Warsaw.">
  <PageHero eyebrow="Selected work" title="Four places. Four new chapters." intro="Each building asked a different question. Our answer in every case was shaped by its architecture, its city and the people who would call it home." index="03" />

  <section class="section-compact shell">
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <img src={project.image} alt={`${project.title} in ${project.location}`} loading="lazy" />
          <div class="project-card-info"><div><p class="project-location">{project.location} · {project.type}</p><h2>{project.title}</h2><p>{project.description}</p></div><a class="project-arrow" href="/contact" aria-label={`Enquire about a project like ${project.title}`}>↗</a></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell quote-section"><div><p class="eyebrow">The common thread</p><p>Tailored, never templated</p></div><blockquote>“A successful restoration should feel inevitable—as if the building had always been waiting to become exactly this.”<p class="quote-byline">CE Reinessance design team</p></blockquote></section>
  <section class="cta-panel"><div><p class="eyebrow">Your next chapter</p><h2>Have a property in mind? We would like to hear its story.</h2></div><div class="cta-actions"><a class="button button-light" href="/contact">Discuss your project <span aria-hidden="true">↗</span></a><a class="text-link light" href="/services">Explore services</a></div></section>
</Layout>
