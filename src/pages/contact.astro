---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Contact the Studio" description="Contact CE Reinessance to discuss a heritage restoration or luxury renovation project in Central Europe.">
  <PageHero eyebrow="Begin a conversation" title="Tell us about the place you have in mind." intro="Share what you know so far—whether it is a property under consideration or a detailed brief. A member of our senior team will respond within one business day." index="04" />

  <section class="section-compact shell contact-layout">
    <aside class="contact-aside">
      <p class="eyebrow">Budapest studio</p>
      <h2>One conversation can reveal what is possible.</h2>
      <div class="contact-detail"><span>Email</span><a href="mailto:project-inquiry@cereinessance.com">project-inquiry@cereinessance.com</a></div>
      <div class="contact-detail"><span>Telephone</span><a href="tel:+3615551234">+36 1 555 1234</a></div>
      <div class="contact-detail"><span>Area served</span><p>Hungary · Austria · Czechia · Poland</p></div>
      <p class="form-note">CE Reinessance is a fictional company. The contact details and form are part of this website concept.</p>
    </aside>

    <form name="contact" method="POST" data-netlify="true" action="/success" class="contact-form">
      <input type="hidden" name="form-name" value="contact" />
      <div class="form-field"><label for="name">Full name *</label><input id="name" type="text" name="name" autocomplete="name" required /></div>
      <div class="form-field"><label for="email">Email address *</label><input id="email" type="email" name="email" autocomplete="email" required /></div>
      <div class="form-field"><label for="location">Project location *</label><input id="location" type="text" name="location" placeholder="City, country" required /></div>
      <div class="form-field"><label for="project-type">Project type *</label><select id="project-type" name="project-type" required><option value="" disabled selected>Select a service</option><option value="heritage">Heritage restoration</option><option value="modernisation">Luxury modernisation</option><option value="direction">Project direction</option><option value="assessment">Property assessment</option><option value="other">Other</option></select></div>
      <div class="form-field"><label for="budget">Indicative budget</label><select id="budget" name="budget"><option value="">Prefer not to say</option><option value="under-500k">Under €500,000</option><option value="500k-1m">€500,000–€1m</option><option value="1m-3m">€1m–€3m</option><option value="3m-plus">€3m+</option></select></div>
      <div class="form-field"><label for="timing">Preferred start</label><select id="timing" name="timing"><option value="exploring">Still exploring</option><option value="0-6">Within 6 months</option><option value="6-12">6–12 months</option><option value="12-plus">12+ months</option></select></div>
      <div class="form-field full"><label for="message">About the property *</label><textarea id="message" name="message" placeholder="Tell us about the building, your ambitions and where you are in the process." required></textarea></div>
      <div class="form-field full"><p class="form-note">By submitting, you agree that we may use this information to respond to your enquiry.</p><button class="button" type="submit">Send project enquiry <span aria-hidden="true">↗</span></button></div>
    </form>
  </section>
</Layout>
