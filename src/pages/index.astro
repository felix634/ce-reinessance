---
import Layout from '../layouts/Layout.astro';
import AnimateOnScroll from '../components/AnimateOnScroll.astro';

const services = [
  { number: '01', title: 'Heritage restoration', copy: 'Sensitive conservation of façades, interiors and original architectural details—guided by specialists and local heritage requirements.' },
  { number: '02', title: 'Luxury modernisation', copy: 'Contemporary comfort, bespoke joinery and intelligent systems introduced with restraint into character-rich properties.' },
  { number: '03', title: 'Project direction', copy: 'One senior team coordinating permits, designers, craftspeople, programme and quality from first survey to final handover.' },
];
---

<Layout title="Exceptional Heritage Renovation in Central Europe" description="Heritage restoration, luxury modernisation and end-to-end renovation management across Budapest, Vienna, Prague and Warsaw.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Central European restoration studio</p>
      <h1>We restore the soul of <em>remarkable</em> places.</h1>
      <p class="hero-lead">Historic character deserves more than preservation. We combine specialist craft, modern performance and calm project leadership to create homes that belong to both their past and their future.</p>
      <div class="hero-actions">
        <a class="button" href="/contact">Begin a conversation <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="/references">Explore selected work</a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="/assets/images/hero.png" alt="Contemporary luxury interior with sculptural lighting and dark stone fireplace" loading="eager" />
      <div class="hero-caption"><span>Private residence</span><span>Central Europe · 2025</span></div>
    </div>
  </section>

  <div class="city-bar" aria-label="Areas served">
    <div class="city-bar-inner"><p>Working across the region</p><p>Budapest</p><p>Vienna</p><p>Prague</p><p>Warsaw</p></div>
  </div>

  <section class="section shell">
    <AnimateOnScroll>
      <div class="section-heading">
        <p class="section-kicker">What we do</p>
        <h2>Old-world integrity.<br /><em>New-world ease.</em></h2>
        <p>Every commission begins with the building itself. We listen to its logic, retain what matters and introduce only what improves the way it is lived in.</p>
      </div>
    </AnimateOnScroll>
    <div class="service-grid">
      {services.map((service, index) => (
        <AnimateOnScroll delay={index * 100}>
          <article class="service-card">
            <span class="service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
            <a class="text-link" href="/services">View service <span aria-hidden="true">↗</span></a>
          </article>
        </AnimateOnScroll>
      ))}
    </div>
  </section>

  <section class="section section-dark">
    <div class="shell">
      <AnimateOnScroll>
        <div class="section-heading">
          <p class="section-kicker">Selected work</p>
          <h2>Spaces with a<br />second life.</h2>
          <p>Four cities, four distinct architectural languages—united by disciplined restoration and quietly confident modern interventions.</p>
        </div>
      </AnimateOnScroll>
      <AnimateOnScroll>
        <article class="project-feature">
          <div class="project-image"><img src="/assets/images/budapest.png" alt="Restored Budapest residence with historic façade and contemporary interior" loading="lazy" /></div>
          <div class="project-info"><p class="project-meta">Budapest · Full restoration</p><h3>The Ambassador’s Residence</h3><p>A 19th-century city residence carefully opened to light while its original rhythm, stonework and street presence were preserved.</p><a class="text-link light" href="/references">See the project <span aria-hidden="true">↗</span></a></div>
        </article>
      </AnimateOnScroll>
      <AnimateOnScroll delay={120}>
        <article class="project-feature reverse">
          <div class="project-image"><img src="/assets/images/vienna.png" alt="Renovated Viennese townhouse illuminated at dusk" loading="lazy" /></div>
          <div class="project-info"><p class="project-meta">Vienna · Interior modernisation</p><h3>The Quiet Townhouse</h3><p>Original proportions and ornamental plasterwork frame a precise, restrained interior made for modern family life.</p><a class="text-link light" href="/references">See all work <span aria-hidden="true">↗</span></a></div>
        </article>
      </AnimateOnScroll>
    </div>
  </section>

  <section class="section shell">
    <AnimateOnScroll>
      <div class="section-heading"><p class="section-kicker">The method</p><h2>Clear from first look<br />to final key.</h2><p>Complex buildings need a simple process. One point of accountability keeps design, approvals, budget and craft aligned.</p></div>
    </AnimateOnScroll>
    <div class="process-grid">
      <div class="process-step"><span>01</span><h3>Discover</h3><p>Property survey, ambition, constraints and a realistic commercial framework.</p></div>
      <div class="process-step"><span>02</span><h3>Define</h3><p>Design direction, permissions, material language and complete scope.</p></div>
      <div class="process-step"><span>03</span><h3>Deliver</h3><p>Skilled construction, transparent reporting and exacting site control.</p></div>
      <div class="process-step"><span>04</span><h3>Handover</h3><p>Detailed review, documentation and attentive post-completion care.</p></div>
    </div>
  </section>

  <section class="section shell quote-section">
    <div><p class="eyebrow">Client perspective</p><p>Budapest, Hungary</p></div>
    <blockquote>“They understood that the details we loved were not obstacles to modern living—they were the foundation of it.”<p class="quote-byline">Private residential client · Historic apartment</p></blockquote>
  </section>

  <section class="cta-panel">
    <div><p class="eyebrow">Your property, reimagined</p><h2>Let’s give an exceptional building its next chapter.</h2></div>
    <div class="cta-actions"><a class="button button-light" href="/contact">Tell us about your project <span aria-hidden="true">↗</span></a><a class="text-link light" href="mailto:project-inquiry@cereinessance.com">Email the studio</a></div>
  </section>
</Layout>
