---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const services = [
  { number: '01', title: 'Heritage restoration', description: 'Historically informed restoration of façades, interiors and structural elements, coordinated with relevant conservation authorities.', details: ['Historic fabric survey', 'Façade and detail conservation', 'Authentic material sourcing'], price: 'Tailored project fee' },
  { number: '02', title: 'Luxury modernisation', description: 'A complete interior transformation that brings modern comfort, refined materiality and intelligent technology to historic spaces.', details: ['Bespoke kitchens and joinery', 'Lighting and smart systems', 'Interior architecture'], price: 'From €2,500 / m²' },
  { number: '03', title: 'Project direction', description: 'Senior oversight of every workstream—from approvals and appointments to procurement, programme, budget and on-site quality.', details: ['Permits and compliance', 'Contractor coordination', 'Cost and quality control'], price: 'From 15% of project value' },
  { number: '04', title: 'Property assessment', description: 'A clear technical and commercial view of a property before purchase or design commitment, including its renovation potential.', details: ['Condition and structural review', 'Feasibility guidance', 'Outline cost plan'], price: 'Fixed fee from €1,500' },
];
---

<Layout title="Renovation Services" description="Heritage restoration, luxury modernisation, project direction and pre-purchase assessments for significant Central European properties.">
  <PageHero eyebrow="What we deliver" title="One studio. Every critical detail." intro="From a focused pre-purchase review to a complete multi-year restoration, our services can stand alone or form one continuous, accountable commission." index="02" />

  <section class="section-compact shell">
    <div class="service-list">
      {services.map((service) => (
        <article class="service-row">
          <span>{service.number}</span>
          <h2>{service.title}</h2>
          <div><p>{service.description}</p><ul>{service.details.map((detail) => <li>{detail}</li>)}</ul></div>
          <div><p class="service-price">{service.price}</p><a class="text-link" href="/contact">Enquire <span aria-hidden="true">↗</span></a></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-dark">
    <div class="shell">
      <div class="section-heading"><p class="section-kicker">Included by design</p><h2>Calm leadership for<br />complex work.</h2><p>The right answer is rarely a catalogue package. We shape the team and scope around the property, then keep every decision visible.</p></div>
      <div class="process-grid"><div class="process-step"><span>A</span><h3>Senior access</h3><p>A lead project director remains close to every important decision.</p></div><div class="process-step"><span>B</span><h3>Clear reporting</h3><p>Programme, budget, risk and next decisions are shared without ambiguity.</p></div><div class="process-step"><span>C</span><h3>Curated teams</h3><p>Specialists are chosen for the property—not from a fixed contractor list.</p></div><div class="process-step"><span>D</span><h3>Aftercare</h3><p>Our relationship continues beyond handover and final completion.</p></div></div>
    </div>
  </section>

  <section class="cta-panel"><div><p class="eyebrow">A considered first step</p><h2>Start with a private project consultation.</h2></div><div class="cta-actions"><a class="button button-light" href="/contact">Request a consultation <span aria-hidden="true">↗</span></a><p>Every engagement begins with a conversation about the property, ambition and timing.</p></div></section>
</Layout>
